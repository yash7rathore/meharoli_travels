{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "meharolitravels.com"
        }
      ],
      "destination": "https://www.meharolitourstravels.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!pictures|assets|favicon|apple-touch-icon|site.webmanifest|sitemap.xml|robots.txt|googled0b71a599009aa5e.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/pictures/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
